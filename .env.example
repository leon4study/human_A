# .env.example — 로컬 실행에 필요한 환경변수 템플릿
#
# 사용법:
#   cp .env.example .env
#   그 다음 비밀번호 등 <CHANGE_ME> 값을 채운다. docker compose 가 .env 를 자동 로드한다.
#
# 호스트명(smart-db, mqtt-broker, data-lake)은 docker-compose.yaml 의 서비스명이다.
# 컨테이너끼리는 이 서비스명으로 통신하므로 로컬 실행 시 그대로 두면 된다.
# (호스트 PC 에서 직접 붙을 때만 localhost 로 바꾼다.)

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=smartfarm
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=smartfarm
POSTGRES_HOST=smart-db
POSTGRES_PORT=5432

# 서비스별 DB 접속 URL — 드라이버 프리픽스(psycopg2/asyncpg)는 각 서비스 구현에 맞춘다.
DATABASE_URL=postgresql://smartfarm:<CHANGE_ME>@smart-db:5432/smartfarm
AI_DATABASE_URL=postgresql://smartfarm:<CHANGE_ME>@smart-db:5432/smartfarm
BE_DATABASE_URL=postgresql://smartfarm:<CHANGE_ME>@smart-db:5432/smartfarm

# ── MQTT 브로커 ──────────────────────────────────────────────
MQTT_BROKER_HOST=mqtt-broker
BE_MQTT_BROKER_HOST=mqtt-broker

# ── MinIO (S3 목업) ──────────────────────────────────────────
S3_ENDPOINT=http://data-lake:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<CHANGE_ME>
S3_BUCKET_NAME=smartfarm-data
